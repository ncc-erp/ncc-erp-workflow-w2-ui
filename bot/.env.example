# ===== Mezon (lấy ở https://mezon.ai/developers -> Application của bot) =====
MEZON_BOT_ID=
MEZON_BOT_TOKEN=

# ===== W2 backend =====
# Gốc của W2 API, bot sẽ gọi {W2_API_BASE_URL}/api/app/mezon/...
W2_API_BASE_URL=https://w2-api.example.com
# Key khớp với W2 appsettings: ApiConfiguration:XSecretKey
W2_API_KEY=
# Khớp với W2 appsettings: ApiConfiguration:SecretKeyHeaderName
W2_API_KEY_HEADER=x-secret-key
# Link web W2 để chèn vào tin nhắn (không bắt buộc)
W2_WEB_URL=https://w2.example.com
W2_TIMEOUT_MS=15000

# ===== HTTP server nhận lệnh từ W2 =====
PORT=3000
# Khớp với W2 appsettings: KomuConfiguration:XSecretKey (W2 gửi qua header X-Secret-Key)
INBOUND_SECRET=

# ===== Định danh user =====
EMAIL_DOMAIN=ncc.asia
# CHẾ ĐỘ CŨ (không khuyến nghị): true = coi Mezon username là phần trước @ của email như KOMU.
# Sai khi username Mezon khác email (vd: anguyenvan112233) và có thể nhận nhầm người.
# false = chỉ tin liên kết đã xác minh (Mezon OAuth hoặc admin import).
TRUST_MEZON_USERNAME_AS_EMAIL=true

# ===== Liên kết tài khoản qua Mezon OAuth (lệnh "*w2 link") =====
# Lấy ở https://mezon.ai/developers -> Application của bot -> OAuth2.
# Đăng ký Redirect URI: {BOT_PUBLIC_URL}/link/callback
# Để trống = tắt, khi đó chỉ liên kết được bằng admin import.
MEZON_OAUTH_CLIENT_ID=
MEZON_OAUTH_CLIENT_SECRET=
MEZON_OAUTH_DOMAIN=https://oauth2.mezon.ai
# URL public user mở được trên trình duyệt (không có / ở cuối)
BOT_PUBLIC_URL=

# Secret cho API admin POST /admin/import-links (để trống = dùng INBOUND_SECRET)
ADMIN_SECRET=

# ===== Khác =====
COMMAND_PREFIX=*w2
DATA_DIR=./data
# debug = log raw event bấm nút (dùng để kiểm tra format extra_data lần đầu)
LOG_LEVEL=info
